    return item
end

-- ========================================
--           ROLES
-- ========================================
local function getRole(targetPlayer)
    local char = targetPlayer.Character
    if not char then return "Unknown" end
    local backpack = targetPlayer:FindFirstChild("Backpack")
    
    local function hasTool(name)
        if char:FindFirstChild(name) then return true end
        if backpack and backpack:FindFirstChild(name) then return true end
        return false
    end
    
    if hasTool("Knife") then return "Murderer" end
    if hasTool("Gun") or hasTool("Revolver") then return "Sheriff" end
    return "Innocent"
end

local function getRoleEmoji(role)
    if role == "Murderer" then return "🔪" end
    if role == "Sheriff" then return "🔫" end
    if role == "Innocent" then return "😇" end
    return "❓"
end

-- ========================================
--           LIMPIEZA ESP
-- ========================================
local function removeESP(targetPlayer)
    if State.ESPObjects[targetPlayer] then
        for _, obj in pairs(State.ESPObjects[targetPlayer]) do
            if obj and obj.Destroy then
                pcall(function() obj:Destroy() end)
            end
        end
        State.ESPObjects[targetPlayer] = nil
    end
end

-- ========================================
--           CREAR ESP POR JUGADOR
-- ========================================
local function createESP(targetPlayer)
    if targetPlayer == player then return end
    local char = targetPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    removeESP(targetPlayer)
    State.ESPObjects[targetPlayer] = {}
    local objs = State.ESPObjects[targetPlayer]
    
    -- Highlight (contorno)
    local hl = Instance.new("Highlight")
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char
    hl.Parent = char
    objs.Highlight = hl
    
    -- Billboard con nombre + distancia
    local head = char:FindFirstChild("Head")
    if head then
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 220, 0, 42)
        bb.StudsOffset = Vector3.new(0, 2.8, 0)
        bb.AlwaysOnTop = true
        bb.Parent = head
        
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0.6, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.Text = ""
        lbl.Parent = bb
        
        local dist = Instance.new("TextLabel")
        dist.Size = UDim2.new(1, 0, 0.4, 0)
        dist.Position = UDim2.new(0, 0, 0.6, 0)
        dist.BackgroundTransparency = 1
        dist.TextColor3 = Color3.fromRGB(0, 220, 255)
        dist.TextStrokeTransparency = 0
        dist.TextStrokeColor3 = Color3.new(0, 0, 0)
        dist.Font = Enum.Font.GothamSemibold
        dist.TextSize = 11
        dist.Text = ""
        dist.Parent = bb
        
        objs.Billboard = bb
        objs.Label = lbl
        objs.DistLabel = dist
    end
    
    -- Caja 2D (Billboard con frame)
    local boxBB = Instance.new("BillboardGui")
    boxBB.Size = UDim2.new(0, 70, 0, 90)
    boxBB.StudsOffset = Vector3.new(0, 1.5, 0)
    boxBB.AlwaysOnTop = true
    boxBB.Adornee = hrp
    boxBB.Enabled = false
    boxBB.Parent = hrp
    
    local boxFrame = Instance.new("Frame")
    boxFrame.Size = UDim2.new(1, 0, 1, 0)
    boxFrame.BackgroundTransparency = 1
    boxFrame.BorderSizePixel = 2
    boxFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    boxFrame.Parent = boxBB
    
    objs.Box2D = boxBB
    objs.Box2DFrame = boxFrame
    
    -- Tracer (línea desde abajo de la pantalla)
    local tracer = Instance.new("Frame")
    tracer.BackgroundColor3 = Color3.fromRGB(0, 220, 255)
    tracer.BorderSizePixel = 0
    tracer.AnchorPoint = Vector2.new(0, 0.5)
    tracer.ZIndex = 2
    tracer.Visible = false
    tracer.Parent = ScreenGui
    objs.Tracer = tracer
    
    -- Highlight del arma en mano
    objs.HandWeaponHL = nil
end

-- ========================================
--           ACTUALIZAR ESP
-- ========================================
local function updateESP(targetPlayer)
    if targetPlayer == player then return end
    local char = targetPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if not State.ESPObjects[targetPlayer] then
        createESP(targetPlayer)
    end
    local objs = State.ESPObjects[targetPlayer]
    if not objs then return end
    
    local role = getRole(targetPlayer)
    local color = ROLE_COLORS[role]
    
    -- Highlight
    if objs.Highlight then
        objs.Highlight.FillColor = color
        objs.Highlight.OutlineColor = color
    end
    
    -- Nombre
    if objs.Label then
        objs.Label.Text = getRoleEmoji(role) .. " " .. targetPlayer.Name
        objs.Label.TextColor3 = color
    end
    
    -- Distancia
    if objs.DistLabel then
        if Config.ESPDistancia then
            local dist = math.floor((camera.CFrame.Position - hrp.Position).Magnitude)
            objs.DistLabel.Text = "[" .. dist .. "m]"
        else
            objs.DistLabel.Text = ""
        end
    end
    
    -- Caja 2D
    if objs.Box2D then
        if Config.ESPCaja2D then
            objs.Box2D.Enabled = true
            objs.Box2DFrame.BorderColor3 = color
        else
            objs.Box2D.Enabled = false
        end
    end
    
    -- Tracer
    if objs.Tracer then
        if Config.ESPTracer then
            local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
            if onScreen and screenPos.Z > 0 then
                local originX = ScreenGui.AbsoluteSize.X * 0.5
                local originY = ScreenGui.AbsoluteSize.Y - 20
                local targetX = screenPos.X
                local targetY = screenPos.Y
                local dx = targetX - originX
                local dy = targetY - originY
                local length = math.sqrt(dx*dx + dy*dy)
                local angle = math.deg(math.atan2(dy, dx))
                
                objs.Tracer.Position = UDim2.new(0, originX, 0, originY)
                objs.Tracer.Size = UDim2.new(0, length, 0, 1.5)
                objs.Tracer.Rotation = angle
                objs.Tracer.BackgroundColor3 = color
                objs.Tracer.Visible = true
            else
                objs.Tracer.Visible = false
            end
        else
            objs.Tracer.Visible = false
        end
    end
    
    -- Arma en mano (highlight del tool que lleva)
    if Config.ESPArmaMano then
        local handTool = nil
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then
                local n = child.Name:lower()
                if n == "knife" or n == "gun" or n == "revolver" then
                    handTool = child
                    break
                end
            end
        end
        
        if handTool and handTool:FindFirstChild("Handle") then
            if not objs.HandWeaponHL or not objs.HandWeaponHL.Parent then
                local hwl = Instance.new("Highlight")
                local n = handTool.Name:lower()
                local wColor = n:find("knife") and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(255, 220, 0)
                hwl.FillColor = wColor
                hwl.OutlineColor = wColor
                hwl.FillTransparency = 0.3
                hwl.OutlineTransparency = 0
                hwl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hwl.Adornee = handTool
                hwl.Parent = handTool
                objs.HandWeaponHL = hwl
            end
        else
            if objs.HandWeaponHL and objs.HandWeaponHL.Parent then
                objs.HandWeaponHL:Destroy()
            end
            objs.HandWeaponHL = nil
        end
    else
        if objs.HandWeaponHL and objs.HandWeaponHL.Parent then
            objs.HandWeaponHL:Destroy()
        end
        objs.HandWeaponHL = nil
    end
end

local function clearESP()
    for p, _ in pairs(State.ESPObjects) do
        removeESP(p)
    end
    State.ESPObjects = {}
end

local function startESPLoop()
    if State.ESPLoop then return end
    State.ESPLoop = true
    task.spawn(function()
        while Config.ESP or Config.ESPCaja2D or Config.ESPTracer or Config.ESPArmaMano or Config.ESPDistancia do
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then
                    pcall(function() updateESP(p) end)
                end
            end
            task.wait(0.15)
        end
        clearESP()
        State.ESPLoop = false
    end)
end

-- ========================================
--           ESP ARMAS TIRADAS
-- ========================================
local function isWeaponTool(obj)
    if not obj:IsA("Tool") then return false end
    local n = obj.Name:lower()
    return n == "knife" or n == "gun" or n == "revolver" or n:find("knife") or n:find("gun")
end

local function getWeaponColor(tool)
    local n = tool.Name:lower()
    if n:find("k
