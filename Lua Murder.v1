-- TAB VISUAL
local visualTab = createTab("Visual", "👁")

createSection(visualTab, "ESP de Roles")
createToggle(visualTab, "🎯 ESP Murderer/Sheriff", false, function(state)
    Config.ESPEnabled = state
    if state then
        startESPLoop()
    else
        clearAllESP()
        if espLoopConn then espLoopConn:Disconnect() end
    end
end)

createToggle(visualTab, "📛 Mostrar Nombres", true, function(state)
    Config.ESPShowNames = state
end)

createSection(visualTab, "Entorno")
createToggle(visualTab, "💡 Fullbright (próximamente)", false, function(state)
    if state then
        game.Lighting.Brightness = 3
        game.Lighting.ClockTime = 14
        game.Lighting.FogEnd = 100000
    else
        game.Lighting.Brightness = 1
    end
end)

-- TAB MOVIMIENTO
local moveTab = createTab("Movimiento", "🏃")

createSection(moveTab, "Velocidad")
createSlider(moveTab, "⚡ Speed", 16, 200, 16, function(v)
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = v end
    end
end)

createSection(moveTab, "Salto")
createSlider(moveTab, "🦘 Jump Power", 50, 300, 50, function(v)
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.JumpPower = v end
    end
end)

