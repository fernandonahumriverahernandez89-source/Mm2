-- ========================================
--           CREAR ITEM (versión compacta)
-- ========================================
local function crearItem(nombre, emoji, callback)
    local item = Instance.new("TextButton")
    item.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    item.Text = ""
    item.BorderSizePixel = 0
    item.AutoButtonColor = false
    item.Parent = ItemsHolder
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = item
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 75)
    stroke.Thickness = 1.5
    stroke.Parent = item
    
    -- Emoji arriba izquierda
    local emojiLbl = Instance.new("TextLabel")
    emojiLbl.Size = UDim2.new(0, 22, 0, 20)
    emojiLbl.Position = UDim2.new(0, 8, 0, 5)
    emojiLbl.BackgroundTransparency = 1
    emojiLbl.Text = emoji
    emojiLbl.TextSize = 16
    emojiLbl.Font = Enum.Font.GothamBold
    emojiLbl.TextXAlignment = Enum.TextXAlignment.Left
    emojiLbl.Parent = item
    
    -- Nombre abajo izquierda
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -14, 0, 14)
    lbl.Position = UDim2.new(0, 8, 1, -18)
    lbl.BackgroundTransparency = 1
    lbl.Text = nombre
    lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = item
    
    -- Switch mini arriba derecha
    local switch = Instance.new("Frame")
    switch.Size = UDim2.new(0, 32, 0, 16)
    switch.Position = UDim2.new(1, -40, 0, 6)
    switch.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    switch.BorderSizePixel = 0
    switch.Parent = item
    
    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switch
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = UDim2.new(0, 2, 0.5, -6)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = switch
    
    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob
    
    local isOn = false
    
    local function setState(state)
        isOn = state
        if isOn then
            switch.BackgroundColor3 = Color3.fromRGB(0, 220, 255)
            knob.Position = UDim2.new(1, -14, 0.5, -6)
            stroke.Color = Color3.fromRGB(0, 220, 255)
            lbl.TextColor3 = Color3.fromRGB(0, 220, 255)
        else
            switch.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
            knob.Position = UDim2.new(0, 2, 0.5, -6)
            stroke.Color = Color3.fromRGB(60, 60, 75)
            lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
        end
        if callback then callback(isOn) end
    end
    
    item.MouseButton1Click:Connect(function()
        setState(not isOn)
    end)
    
    return setState
end

-- ========================================
--           ESP DE ROLES
-- ========================================
local function getRole(targetPlayer)
    local char = targetPlayer.Character
    if not char then return "Unknown" end
    local backpack = targetPlayer:FindFirstChild("Backpack")
    
    local function hasTool(name)
        if char:FindFirstChild(name) then return true end
        if backpack and backpack:FindFirstChild(name) then return true end
        return false
    end
    
    if hasTool("Knife") then return "Murderer" end
    if hasTool("Gun") or hasTool("Revolver") then return "Sheriff" end
    return "Innocent"
end

local function removeESP(targetPlayer)
    if State.ESPObjects[targetPlayer] then
        for _, obj in pairs(State.ESPObjects[targetPlayer]) do
            if obj and obj.Destroy then obj:Destroy() end
        end
        State.ESPObjects[targetPlayer] = nil
    end
end

local function createESP(targetPlayer)
    if targetPlayer == player then return end
    local char = targetPlayer.Character
    if not char then return end
    
    removeESP(targetPlayer)
    State.ESPObjects[targetPlayer] = {}
    
    local hl = Instance.new("Highlight")
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char
    hl.Parent = char
    State.ESPObjects[targetPlayer].Highlight = hl
    
    local head = char:FindFirstChild("Head")
    if head then
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 220, 0, 42)
        bb.StudsOffset = Vector3.new(0, 2.8, 0)
        bb.AlwaysOnTop = true
        bb.Parent = head
        
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0.6, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.Text = ""
        lbl.Parent = bb
        
        local dist = Instance.new("TextLabel")
        dist.Size = UDim2.new(1, 0, 0.4, 0)
        dist.Position = UDim2.new(0, 0, 0.6, 0)
        dist.BackgroundTransparency = 1
        dist.TextColor3 = Color3.fromRGB(0, 220, 255)
        dist.TextStrokeTransparency = 0
        dist.TextStrokeColor3 = Color3.new(0, 0, 0)
        dist.Font = Enum.Font.GothamSemibold
        dist.TextSize = 11
        dist.Text = ""
        dist.Parent = bb
        
        State.ESPObjects[targetPlayer].Billboard = bb
        State.ESPObjects[targetPlayer].Label = lbl
        State.ESPObjects[targetPlayer].DistLabel = dist
    end
end

local function updateESP(targetPlayer)
    if targetPlayer == player then return end
    local char = targetPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    if not State.ESPObjects[targetPlayer] then
        createESP(targetPlayer)
    end
    
    local role = getRole(targetPlayer)
    local color = ROLE_COLORS[role]
    local objs = State.ESPObjects[targetPlayer]
    
    if objs.Highlight then
        objs.Highlight.FillColor = color
        objs.Highlight.OutlineColor = color
    end
    
    if objs.Label then
        local emoji = role == "Murderer" and "🔪" or role == "Sheriff" and "🔫" or role == "Innocent" and "😇" or "❓"
        objs.Label.Text = emoji .. " " .. targetPlayer.Name
        objs.Label.TextColor3 = color
    end
    
    if objs.DistLabel then
        if Config.ESPDistancia then
            local dist = math.floor((camera.CFrame.Position - char.HumanoidRootPart.Position).Magnitude)
            objs.DistLabel.Text = "[" .. dist .. "m]"
        else
            objs.DistLabel.Text = ""
        end
    end
end

local function clearESP()
    for p, _ in pairs(State.ESPObjects) do
        removeESP(p)
    end
    State.ESPObjects = {}
end

local function startESPLoop()
    if State.ESPLoop then return end
    State.ESPLoop = true
    task.spawn(function()
        while Config.ESP do
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then updateESP(p) end
            end
            task.wait(0.3)
        end
        State.ESPLoop = false
    end)
end

-- ========================================
--           ESP DE ARMAS TIRADAS (ARREGLADO)
-- ========================================
local function isWeaponTool(obj)
    if not obj:IsA("Tool") then return false end
    local n = obj.Name:lower()
    return n == "knife" or n == "gun" or n == "revolver" or n:find("knife") or n:find("gun")
end

local function getWeaponColor(tool)
    local n = tool.Name:lower()
    if n:find("knife") then
        return Color3.fromRGB(255, 140, 0)   -- Naranja para cuchillo
    elseif n:find("gun") or n:find("revolver") then
        return Color3.fromRGB(255, 220, 0)   -- Amarillo para pistola
    end
    return Color3.fromRGB(255, 220, 0)
end

local function findDroppedWeapons()
    local weapons = {}
    local seen = {}
    
    -- 1. Buscar en workspace.Dropped
    local dropped = workspace:FindFirstChild("Dropped")
    if dropped then
        for _, obj in ipairs(dropped:GetChildren()) do
            if isWeaponTool(obj) and not seen[obj] then
                seen[obj] = true
                table.insert(weapons, obj)
            end
        end
    end
    
    -- 2. Buscar directamente en workspace (a veces las armas caen ahí)
    for _, obj in ipairs(workspace:GetChildren()) do
        if isWeaponTool(obj) and not seen[obj] then
            seen[obj] = true
            table.insert(weapons, obj)
        end
    end
    
    -- 3. Buscar en otros contenedores comunes
    for _, container in ipairs(workspace:GetChildren()) do
        if container:IsA("Folder") and container.Name ~= "Dropped" then
            for _, obj in ipairs(container:GetChildren()) do
                if isWeaponTool(obj) and not seen[obj] then
                    seen[obj] = true
                    table.insert(weapons, obj)
                end
            end
        end
    end
    
    return weapons
end

local function clearWeaponESP()
    for tool, obj in pairs(State.ESPArmasObjects) do
        if obj and obj.Destroy then obj:Destroy() end
    end
    State.ESPArmasObjects = {}
end

local function updateWeaponESP()
    local currentWeapons = findDroppedWeapons()
    local currentSet = {}
    
    for _, tool in ipairs(currentWeapons) do
        currentSet[tool] = true
        if not State.ESPArmasObjects[tool] or not State.ESPArmasObjects[tool].Parent then
            if State.ESPArmasObjects[tool] then
                State.ESPArmasObjects[tool]:Destroy()
            end
            local hl = Instance.new("Highlight")
            local color = getWeaponColor(tool)
            hl.FillColor = color
            hl.OutlineColor = color
            hl.FillTransparency = 0.3
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = tool
            hl.Parent = tool
            State.ESPArmasObjects[tool] = hl
        end
    end
    
    for tool, obj in pairs(State.ESPArmasObjects) do
        if not currentSet[tool] or not tool.Parent then
            if obj and obj.Destroy then obj:Destroy() end
            State.ESPArmasObjects[tool] = nil
        end
    end
end

local function startArmasLoop()
    if State.ArmasLoop then return end
    State.ArmasLoop = true
    task.spawn(function()
        while Config.ESPArmas do
            updateWeaponESP()
            task.wait(0.4)
        end
        clearWeaponESP()
        State.ArmasLoop = false
    end)
end

-- ========================================
--           MOVIMIENTO
-- ========================================
local function getHumanoid()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function aplicarSpeed()
    local hum = getHumanoid()
    if hum then
        hum.WalkSpeed = Config.Speed and SPEED_VALUE or originalSpeed
    end
end

local function toggleJump(state)
    if state then
        if State.JumpConn then State.JumpConn:Disconnect() end
        State.JumpConn = UserInputService.JumpRequest:Connect(function()
            if Config.Jump then
                local hum = getHumanoid()
                if hum then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end)
    else
        if State.JumpConn then
            State.JumpConn:Disconnect()
            State.JumpConn = nil
        end
    end
end

local function toggleNoclip(state)
    if state then
        if State.NoclipConn then State.NoclipConn:Disconnect() end
        State.NoclipConn = RunService.Stepped:Connect(function()
            if Config.Noclip then
                local char = player.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end
        end)
    else
        if State.NoclipConn then
            State.NoclipConn:Disconnect()
            State.NoclipConn = nil
        end
        local char = player.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- ========================================
--           FULLBRIGHT
-- ========================================
local originalLighting = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    FogEnd = Lighting.FogEnd,
    GlobalShadows = Lighting.GlobalShadows,
    Ambient = Lighting.Ambient,
}

local function aplicarFullbright(state)
    if state then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
    else
        Lighting.Brightness = originalLighting.Brightness
        Lighting.ClockTime = originalLighting.ClockTime
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.GlobalShadows = originalLighting.GlobalShadows
        Lighting.Ambient = originalLighting.Ambient
    end
end

-- ========================================
--           CREAR ITEMS
-- ========================================
crearItem("ESP Roles", "🎯", function(s)
    Config.ESP = s
    if s then startESPLoop() else clearESP() end
end)

crearItem("Distancia", "📏", function(s)
    Config.ESPDistancia = s
end)

crearItem("Armas ESP", "🔫", function(s)
    Config.ESPArmas = s
    if s then startArmasLoop() else clearWeaponESP() end
end)

crearItem("Speed", "⚡", function(s)
    Config.Speed = s
    aplicarSpeed()
end)

crearItem("Inf Jump", "🦘", function(s)
    Config.Jump = s
    toggleJump(s)
end)

crearItem("Noclip", "👻", function(s)
    Config.Noclip = s
    toggleNoclip(s)
end)

crearItem("Fullbright", "💡", function(s)
    Config.Fullbright = s
    aplicarFullbright(s)
end)

-- ========================================
--           ABRIR / CERRAR
-- ========================================
OpenBtn.MouseButton1Click:Connect(function()
    Panel.Visible = true
    OpenBtn.Visible = false
end)

CloseBtn.MouseButton1Click:Connect(function()
    Panel.Visible = false
    OpenBtn.Visible = true
end)

-- ========================================
--           LIMPIEZA
-- ========================================
Players.PlayerRemoving:Connect(function(p)
    removeESP(p)
end)

player.CharacterAdded:Connect(function()
    task.wait(1)
    originalSpeed = 16
    aplicarSpeed()
end)

print("✅ MM2 UI v3 cargada")
