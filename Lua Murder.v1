-- Crear item con efecto
local function crearItem(nombre, emoji, callback)
    local item = Instance.new("TextButton")
    item.BackgroundColor3 = Theme.Item
    item.Text = ""
    item.BorderSizePixel = 0
    item.AutoButtonColor = false
    item.Parent = ItemsHolder
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = item
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(80, 50, 55)
    stroke.Thickness = 1.5
    stroke.Parent = item
    
    local ej = Instance.new("TextLabel")
    ej.Size = UDim2.new(0, 22, 0, 20)
    ej.Position = UDim2.new(0, 8, 0, 4)
    ej.BackgroundTransparency = 1
    ej.Text = emoji
    ej.TextSize = 15
    ej.Font = Enum.Font.GothamBold
    ej.TextXAlignment = Enum.TextXAlignment.Left
    ej.Parent = item
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -14, 0, 14)
    lbl.Position = UDim2.new(0, 8, 1, -17)
    lbl.BackgroundTransparency = 1
    lbl.Text = nombre
    lbl.TextColor3 = Theme.Text
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = item
    
    local sw = Instance.new("Frame")
    sw.Size = UDim2.new(0, 30, 0, 15)
    sw.Position = UDim2.new(1, -38, 0, 6)
    sw.BackgroundColor3 = Theme.Off
    sw.BorderSizePixel = 0
    sw.Parent = item
    
    local c5 = Instance.new("UICorner")
    c5.CornerRadius = UDim.new(1, 0)
    c5.Parent = sw
    
    local kn = Instance.new("Frame")
    kn.Size = UDim2.new(0, 11, 0, 11)
    kn.Position = UDim2.new(0, 2, 0.5, -5.5)
    kn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    kn.BorderSizePixel = 0
    kn.Parent = sw
    
    local c6 = Instance.new("UICorner")
    c6.CornerRadius = UDim.new(1, 0)
    c6.Parent = kn
    
    local isOn = false
    local function setState(state)
        isOn = state
        if isOn then
            sw.BackgroundColor3 = Theme.Primary
            kn.Position = UDim2.new(1, -13, 0.5, -5.5)
            stroke.Color = Theme.Primary
            lbl.TextColor3 = Theme.Primary
            -- Efecto de brillo al activar
            local glow = TweenService:Create(stroke, TweenInfo.new(0.3), {
                Transparency = 0.5
            })
            glow:Play()
            task.delay(0.3, function()
                TweenService:Create(stroke, TweenInfo.new(0.3), {
                    Transparency = 0
                }):Play()
            end)
        else
            sw.BackgroundColor3 = Theme.Off
            kn.Position = UDim2.new(0, 2, 0.5, -5.5)
            stroke.Color = Color3.fromRGB(80, 50, 55)
            lbl.TextColor3 = Theme.Text
        end
        if callback then pcall(callback, isOn) end
    end
    
    item.MouseButton1Click:Connect(function()
        setState(not isOn)
    end)
end

-- ========================================
--           ROLES
-- ========================================
local function getRole(targetPlayer)
    local char = targetPlayer.Character
    if not char then return "Unknown" end
    local bp = targetPlayer:FindFirstChild("Backpack")
    local function hasTool(name)
        if char:FindFirstChild(name) then return true end
        if bp and bp:FindFirstChild(name) then return true end
        return false
    end
    if hasTool("Knife") then return "Murderer" end
    if hasTool("Gun") or hasTool("Revolver") then return "Sheriff" end
    return "Innocent"
end

-- ========================================
--           ESP
-- ========================================
local function removeESP(p)
    if State.ESPObjects[p] then
        for _, obj in pairs(State.ESPObjects[p]) do
            if obj and obj.Destroy then
                pcall(function() obj:Destroy() end)
            end
        end
        State.ESPObjects[p] = nil
    end
end

local function createESP(targetPlayer)
    if targetPlayer == player then return end
    local char = targetPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    removeESP(targetPlayer)
    State.ESPObjects[targetPlayer] = {}
    local objs = State.ESPObjects[targetPlayer]
    objs.Char = char
    
    local hl = Instance.new("Highlight")
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char
    hl.Parent = char
    objs.Highlight = hl
    
    local head = char:FindFirstChild("Head")
    if head then
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 220, 0, 42)
        bb.StudsOffset = Vector3.new(0, 2.8, 0)
        bb.AlwaysOnTop = true
        bb.Parent = head
        
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0.6, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.Text = ""
        lbl.Parent = bb
        
        local dist = Instance.new("TextLabel")
        dist.Size = UDim2.new(1, 0, 0.4, 0)
        dist.Position = UDim2.new(0, 0, 0.6, 0)
        dist.BackgroundTransparency = 1
        dist.TextColor3 = Theme.Accent
        dist.TextStrokeTransparency = 0
        dist.TextStrokeColor3 = Color3.new(0, 0, 0)
        dist.Font = Enum.Font.GothamSemibold
        dist.TextSize = 11
        dist.Text = ""
        dist.Parent = bb
        
        objs.Label = lbl
        objs.DistLabel = dist
    end
    
    local boxBB = Instance.new("BillboardGui")
    boxBB.Size = UDim2.new(0, 70, 0, 90)
    boxBB.StudsOffset = Vector3.new(0, 1.5, 0)
    boxBB.AlwaysOnTop = true
    boxBB.Adornee = hrp
    boxBB.Enabled = false
    boxBB.Parent = hrp
    
    local boxFrame = Instance.new("Frame")
    boxFrame.Size = UDim2.new(1, 0, 1, 0)
    boxFrame.BackgroundTransparency = 1
    boxFrame.BorderSizePixel = 2
    boxFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    boxFrame.Parent = boxBB
    
    objs.Box2D = boxBB
    objs.BoxFrame = boxFrame
end

local function updateESP(targetPlayer)
    if targetPlayer == player then return end
    local char = targetPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local objs = State.ESPObjects[targetPlayer]
    if not objs or objs.Char ~= char or not objs.Char.Parent then
        removeESP(targetPlayer)
        createESP(targetPlayer)
        objs = State.ESPObjects[targetPlayer]
    end
    if not objs then return end
    
    local role = getRole(targetPlayer)
    local color = ROLE_COLORS[role]
    
    if objs.Highlight and objs.Highlight.Parent then
        objs.Highlight.FillColor = color
        objs.Highlight.OutlineColor = color
    end
    
    if objs.Label and objs.Label.Parent then
        local emoji = role == "Murderer" and "🔪" or role == "Sheriff" and "🔫" or role == "Innocent" and "😇" or "❓"
        objs.Label.Text = emoji .. " " .. targetPlayer.Name
        objs.Label.TextColor3 = color
    end
    
    if objs.DistLabel and objs.DistLabel.Parent then
        if Config.ESPDistancia then
            local d = math.floor((camera.CFrame.Position - hrp.Position).Magnitude)
            objs.DistLabel.Text = "[" .. d .. "m]"
        else
            objs.DistLabel.Text = ""
        end
    end
    
    if objs.Box2D and objs.Box2D.Parent then
        if Config.ESPCaja2D then
            objs.Box2D.Enabled = true
            objs.BoxFrame.BorderColor3 = color
        else
            objs.Box2D.Enabled = false
        end
    end
end

local function clearESP()
    for p, _ in pairs(State.ESPObjects) do
        removeESP(p)
    end
    State.ESPObjects = {}
end

local function startESPLoop()
    if State.ESPLoop then return end
    State.ESPLoop = true
    task.spawn(function()
        while Config.ESP or Config.ESPCaja2D or Config.ESPDistancia do
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then
                    pcall(function() updateESP(p) end)
                end
            end
            task.wait(0.2)
        end
        clearESP()
        State.ESPLoop = false
    end)
end

-- ========================================
--           ARMAS TIRADAS
-- ========================================
local function isDroppedWeapon(obj)
    if not obj:IsA("Tool") then return false end
    if not obj:FindFirstChild("Handle") then return false end
    local n = obj.Name:lower()
    if not (n:find("knife") or n:find("gun") or n:find("revolver")) then return false end
    local parent = obj.Parent
    if not parent then return false end
    if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then return false end
    if parent:IsA("Backpack") then return false end
    if parent.Name == "Backpack" then return false end
    return true
end

local function findWeapons()
    local list = {}
    local seen = {}
    local ok, descendants = pcall(function() return workspace:GetDescendants() end)
    if ok and descendants then
        for _, obj in ipairs(descendants) do
            if not seen[obj] and isDroppedWeapon(obj) then
                seen[obj] = true
                table.insert(list, obj)
            end
        end
    end
    return list
end

local function clearWeaponESP()
    for _, obj in pairs(State.ESPArmasObjects) do
        if obj and obj.Destroy then pcall(function() obj:Destroy() end) end
    end
    State.ESPArmasObjects = {}
end

local function updateWeaponESP()
    local cur = findWeapons()
    local set = {}
    for _, t in ipairs(cur) do
        set[t] = true
        if not State.ESPArmasObjects[t] or not State.ESPArmasObjects[t].Parent then
            if State.ESPArmasObjects[t] then 
                pcall(function() State.ESPArmasObjects[t]:Destroy() end) 
            end
            local hl = Instance.new("Highlight")
            local n = t.Name:lower()
            local col = n:find("knife") and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(255, 220, 0)
            hl.FillColor = col
            hl.OutlineColor = col
            hl.FillTransparency = 0.3
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = t
            hl.Parent = t
            State.ESPArmasObjects[t] = hl
        end
    end
    for t, o in pairs(State.ESPArmasObjects) do
        if not set[t] or not t.Parent then
            if o and o.Destroy then pcall(function() o:Destroy() end) end
            State.ESPArmasObjects[t] = nil
        end
    end
end

local function startArmasLoop()
    if State.ArmasLoop then return end
    State.ArmasLoop = true
    task.spawn(function()
        while Config.ESPArmas do
            pcall(updateWeaponESP)
            task.wait(0.6)
        end
        clearWeaponESP()
        State.ArmasLoop = false
    end)
end

-- ========================================
--           MOVIMIENTO
-- ========================================
local function getHum()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function aplicarSpeed()
    local hum = getHum()
    if hum then
        hum.WalkSpeed = Config.Speed and SPEED_VALUE or originalSpeed
    end
end

local function toggleJump(state)
    if state then
        if State.JumpConn then State.JumpConn:Disconnect() end
        State.JumpConn = UserInputService.JumpRequest:Connect(function()
            if Config.Jump then
                local hum = getHum()
                if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
            end
        end)
    else
        if State.JumpConn then
            State.JumpConn:Disconnect()
            State.JumpConn = nil
        end
    end
end

local function toggleNoclip(state)
    if state then
        if State.NoclipConn then State.NoclipConn:Disconnect() end
        State.NoclipConn = RunService.Stepped:Connect(function()
            if Config.Noclip then
                local char = player.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end
        end)
    else
        if State.NoclipConn then
            State.NoclipConn:Disconnect()
            State.NoclipConn = nil
        end
        local char = player.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
    end
end

local origLight = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    FogEnd = Lighting.FogEnd,
    GlobalShadows = Lighting.GlobalShadows,
    Ambient = Lighting.Ambient,
}

local function aplicarFullbright(state)
    if state then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
    else
        Lighting.Brightness = origLight.Brightness
        Lighting.ClockTime = origLight.ClockTime
        Lighting.FogEnd = origLight.FogEnd
        Lighting.GlobalShadows = origLight.GlobalShadows
        Lighting.Ambient = origLight.Ambient
    end
end

-
