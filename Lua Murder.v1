-- ========================================
--           SISTEMA DE TABS
-- ========================================
local Tabs = {}

local function createTab(tabName)
    -- Botón de tab
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0, 115, 0, 26)
    tabBtn.BackgroundColor3 = Theme.TabIdle
    tabBtn.TextColor3 = Theme.Text
    tabBtn.Text = tabName
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 11
    tabBtn.BorderSizePixel = 0
    tabBtn.AutoButtonColor = false
    tabBtn.Parent = TabBar
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = tabBtn
    
    -- Contenido
    local content = Instance.new("ScrollingFrame")
    content.Size = UDim2.new(1, 0, 1, 0)
    content.BackgroundTransparency = 1
    content.BorderSizePixel = 0
    content.ScrollBarThickness = 3
    content.ScrollBarImageColor3 = Theme.Primary
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    content.Visible = false
    content.Parent = ContentFrame
    
    local layout = Instance.new("UIGridLayout")
    layout.CellSize = UDim2.new(0, 184, 0, 44)
    layout.CellPadding = UDim2.new(0, 6, 0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = content
    
    Tabs[tabName] = { Button = tabBtn, Content = content }
    
    -- Al tocar la tab
    tabBtn.MouseButton1Click:Connect(function()
        for name, t in pairs(Tabs) do
            t.Content.Visible = false
            t.Button.BackgroundColor3 = Theme.TabIdle
            t.Button.TextColor3 = Theme.Text
        end
        content.Visible = true
        tabBtn.BackgroundColor3 = Theme.TabActive
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        State.CurrentTab = tabName
    end)
    
    return content
end

-- ========================================
--           🔔 NOTIFICACIONES
-- ========================================
local NotifHolder = Instance.new("Frame")
NotifHolder.Size = UDim2.new(0, 220, 0, 200)
NotifHolder.Position = UDim2.new(1, -230, 0, 100)
NotifHolder.BackgroundTransparency = 1
NotifHolder.Parent = ScreenGui

local NotifLayout = Instance.new("UIListLayout")
NotifLayout.Padding = UDim.new(0, 6)
NotifLayout.SortOrder = Enum.SortOrder.LayoutOrder
NotifLayout.VerticalAlignment = Enum.VerticalAlignment.Top
NotifLayout.Parent = NotifHolder

local function notificar(texto, tipo)
    local color = tipo == "off" and Theme.PrimaryDark or Theme.Primary
    local icon = tipo == "off" and "⭕" or "✅"
    
    local notif = Instance.new("TextButton")
    notif.Size = UDim2.new(1, 0, 0, 36)
    notif.BackgroundColor3 = Theme.Background
    notif.BackgroundTransparency = 0.1
    notif.Text = ""
    notif.BorderSizePixel = 0
    notif.AutoButtonColor = false
    notif.Parent = NotifHolder
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = notif
    
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = 1.5
    s.Parent = notif
    
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, -8)
    bar.Position = UDim2.new(0, 4, 0, 4)
    bar.BackgroundColor3 = color
    bar.BorderSizePixel = 0
    bar.Parent = notif
    
    local cbar = Instance.new("UICorner")
    cbar.CornerRadius = UDim.new(1, 0)
    cbar.Parent = bar
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = icon .. " " .. texto
    lbl.TextColor3 = Theme.Text
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = notif
    
    -- Animación entrada
    notif.Position = UDim2.new(1, 0, 0, 0)
    TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()
    
    -- Auto-eliminar
    task.delay(2.5, function()
        if notif and notif.Parent then
            local t = TweenService:Create(notif, TweenInfo.new(0.3), {
                Position = UDim2.new(1, 0, 0, 0),
                BackgroundTransparency = 1
            })
            t:Play()
            t.Completed:Connect(function()
                pcall(function() notif:Destroy() end)
            end)
        end
    end)
end

-- ========================================
--           CREAR ITEM
-- ========================================
local function crearItem(parent, nombre, emoji, callback)
    local item = Instance.new("TextButton")
    item.BackgroundColor3 = Theme.Item
    item.BackgroundTransparency = 0.1
    item.Text = ""
    item.BorderSizePixel = 0
    item.AutoButtonColor = false
    item.Parent = parent
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = item
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(80, 50, 55)
    stroke.Thickness = 1.5
    stroke.Parent = item
    
    local ej = Instance.new("TextLabel")
    ej.Size = UDim2.new(0, 22, 0, 20)
    ej.Position = UDim2.new(0, 8, 0, 4)
    ej.BackgroundTransparency = 1
    ej.Text = emoji
    ej.TextSize = 15
    ej.Font = Enum.Font.GothamBold
    ej.TextXAlignment = Enum.TextXAlignment.Left
    ej.Parent = item
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -14, 0, 14)
    lbl.Position = UDim2.new(0, 8, 1, -17)
    lbl.BackgroundTransparency = 1
    lbl.Text = nombre
    lbl.TextColor3 = Theme.Text
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = item
    
    local sw = Instance.new("Frame")
    sw.Size = UDim2.new(0, 30, 0, 15)
    sw.Position = UDim2.new(1, -38, 0, 6)
    sw.BackgroundColor3 = Theme.Off
    sw.BorderSizePixel = 0
    sw.Parent = item
    
    local csw = Instance.new("UICorner")
    csw.CornerRadius = UDim.new(1, 0)
    csw.Parent = sw
    
    local kn = Instance.new("Frame")
    kn.Size = UDim2.new(0, 11, 0, 11)
    kn.Position = UDim2.new(0, 2, 0.5, -5.5)
    kn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    kn.BorderSizePixel = 0
    kn.Parent = sw
    
    local ckn = Instance.new("UICorner")
    ckn.CornerRadius = UDim.new(1, 0)
    ckn.Parent = kn
    
    local isOn = false
    local function setState(state, notif)
        isOn = state
        if isOn then
            sw.BackgroundColor3 = Theme.Primary
            kn.Position = UDim2.new(1, -13, 0.5, -5.5)
            stroke.Color = Theme.Primary
            lbl.TextColor3 = Theme.Primary
            if notif then notificar(nombre .. " activado", "on") end
        else
            sw.BackgroundColor3 = Theme.Off
            kn.Position = UDim2.new(0, 2, 0.5, -5.5)
            stroke.Color = Color3.fromRGB(80, 50, 55)
            lbl.TextColor3 = Theme.Text
            if notif then notificar(nombre .. " desactivado", "off") end
        end
        if callback then pcall(callback, isOn) end
    end
    
    item.MouseButton1Click:Connect(function()
        setState(not isOn, true)
    end)
end

-- ========================================
--           ROLES
-- ========================================
local function getRole(targetPlayer)
    local char = targetPlayer.Character
    if not char then return "Unknown" end
    local bp = targetPlayer:FindFirstChild("Backpack")
    local function hasTool(name)
        if char:FindFirstChild(name) then return true end
        if bp and bp:FindFirstChild(name) then return true end
        return false
    end
    if hasTool("Knife") then return "Murderer" end
    if hasTool("Gun") or hasTool("Revolver") then return "Sheriff" end
    return "Innocent"
end

-- ========================================
--           ESP LÓGICA
-- ========================================
local function removeESP(p)
    if State.ESPObjects[p] then
        for _, obj in pairs(State.ESPObjects[p]) do
            if obj and obj.Destroy then pcall(function() obj:Destroy() end) end
        end
        State.ESPObjects[p] = nil
    end
end

local function createESP(targetPlayer)
    if targetPlayer == player then return end
    local char = targetPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    removeESP(targetPlayer)
    State.ESPObjects[targetPlayer] = {}
    local objs = State.ESPObjects[targetPlayer]
    objs.Char = char
    
    local hl = Instance.new("Highlight")
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char
    hl.Parent = char
    objs.Highlight = hl
    
    local head = char:FindFirstChild("Head")
    if head then
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 220, 0, 42)
        bb.StudsOffset = Vector3.new(0, 2.8, 0)
        bb.AlwaysOnTop = true
        bb.Parent = head
        
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0.6, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.Text = ""
        lbl.Parent = bb
        
        local dist = Instance.new("TextLabel")
        dist.Size = UDim2.new(1, 0, 0.4, 0)
        dist.Position = UDim2.new(0, 0, 0.6, 0)
        dist.BackgroundTransparency = 1
        dist.TextColor3 = Theme.Accent
        dist.TextStrokeTransparency = 0
        dist.TextStrokeColor3 = Color3.new(0, 0, 0)
        dist.Font = Enum.Font.GothamSemibold
        dist.TextSize = 11
        dist.Text = ""
        dist.Parent = bb
        
        objs.Label = lbl
        objs.DistLabel = dist
    end
    
    local boxBB = Instance.new("BillboardGui")
    boxBB.Size = UDim2.new(0, 70, 0, 90)
    boxBB.StudsOffset = Vector3.new(0, 1.5, 0)
    boxBB.AlwaysOnTop = true
    boxBB.Adornee = hrp
    boxBB.Enabled = false
    boxBB.Parent = hrp
    
    local boxFrame = Instance.new("Frame")
    boxFrame.Size = UDim2.new(1, 0, 1, 0)
    boxFrame.BackgroundTransparency = 1
    boxFrame.BorderSizePixel = 2
    boxFrame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    boxFrame.Parent = boxBB
    
    objs.Box2D = boxBB
    objs.BoxFrame = boxFrame
end

local function updateESP(targetPlayer)
    if targetPlayer == player then return end
    local char = targetPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local objs = State.ESPObjects[targetPlayer]
    if not objs or objs.Char ~= char or not objs.Char.Parent then
        removeESP(targetPlayer)
        createESP(targetPlayer)
        objs = State.ESPObjects[targetPlayer]
    end
    if not objs then return end
    
    local role = getRole(targetPlayer)
    local color = ROLE_COLORS[role]
    
    if objs.Highlight and objs.Highlight.Parent then
        objs.Highlight.FillColor = color
        objs.Highlight.OutlineColor = color
    end
    
    if objs.Label and objs.Label.Parent then
        local emoji = role == "Murderer" and "🔪" or role == "Sheriff" and "🔫" or role == "Innocent" and "😇" or "❓"
        objs.Label.Text = emoji .. " " .. targetPlayer.Name
        objs.Label.TextColor3 = color
    end
    
    if objs.DistLabel and objs.DistLabel.Parent then
        if Config.ESPDistancia then
            local d = math.floor((camera.CFrame.Position - hrp.Position).Magnitude)
            objs.DistLabel.Text = "[" .. d .. "m]"
        else
            objs.DistLabel.Text = ""
        end
    end
    
    if objs.Box2D and objs.Box2D.Parent then
        if Config.ESPCaja2D then
            objs.Box2D.Enabled = true
            objs.BoxFrame.BorderColor3 = color
        else
            objs.Box2D.Enabled = false
        end
    end
end

local function clearESP()
    for p, _ in pairs(State.ESPObjects) do removeESP(p) end
    State.ESPObjects = {}
end

local function startESPLoop()
    if State.ESPLoop then return end
    State.ESPLoop = true
    task.spawn(function()
        while Config.ESP or Config.ESPCaja2D or Config.ESPDistancia do
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then pcall(function() updateESP(p) end) end
            end
            task.wait(0.2)
        end
        clearESP()
        State.ESPLoop = false
    end)
end

-- ========================================
--           ARMAS TIRADAS
-- ========================================
local function isDroppedWeapon(obj)
    if not obj:IsA("Tool") then return false end
    if not obj:FindFirstChild("Handle") then return false end
    local n = obj.Name:lower()
    if not (n:find("knife") or n:find("gun") or n:find("revolver")) then return false end
    local parent = obj.Parent
    if not parent then return false end
    if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then return false end
    if parent:IsA("Backpack") or parent.Name == "Backpack" then return false end
    return true
end

local function fin
