--[[ =============================================
     MM2 ESP DE ROLES - Delta Executor
     Compatible: 📱 Celular y 💻 PC
     ============================================= ]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- ============ CONFIGURACIÓN ============
local UPDATE_RATE = 0.5  -- cada cuántos segundos actualiza
local SHOW_NAMES = true  -- mostrar nombre arriba del jugador
-- =======================================

local espEnabled = false
local highlights = {}   -- [player] = Highlight
local nameTags = {}     -- [player] = BillboardGui

-- Colores por rol
local ROLE_COLORS = {
    Murderer = Color3.fromRGB(255, 30, 30),    -- rojo
    Sheriff  = Color3.fromRGB(30, 120, 255),   -- azul
    Innocent = Color3.fromRGB(30, 255, 80),    -- verde
    Unknown  = Color3.fromRGB(200, 200, 200),  -- gris
}

-- ============ GUI ============
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MM2_ESP"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.Parent = player:WaitForChild("PlayerGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 70, 0, 70)
btn.Position = UDim2.new(0, 20, 0.4, 0)
btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
btn.BackgroundTransparency = 0.2
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Text = "🎯\nESP"
btn.Font = Enum.Font.GothamBold
btn.TextSize = 14
btn.BorderSizePixel = 0
btn.Active = true
btn.Draggable = true
btn.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = btn

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(150, 150, 150)
stroke.Thickness = 2
stroke.Parent = btn

-- ============ FUNCIONES ============

-- Detecta el rol de un jugador
local function getRole(targetPlayer)
    local char = targetPlayer.Character
    if not char then return "Unknown" end
    
    local backpack = targetPlayer:FindFirstChild("Backpack")
    
    -- Buscar en personaje y mochila
    local function hasTool(name)
        if char:FindFirstChild(name) then return true end
        if backpack and backpack:FindFirstChild(name) then return true end
        return false
    end
    
    if hasTool("Knife") then
        return "Murderer"
    elseif hasTool("Gun") or hasTool("Revolver") then
        return "Sheriff"
    else
        -- Si la ronda está activa y no tiene nada, es Innocent
        return "Innocent"
    end
end

-- Crea el Highlight de un jugador
local function createESP(targetPlayer)
    if targetPlayer == player then return end  -- no mostrarnos a nosotros
    
    local char = targetPlayer.Character
    if not char then return end
    
    -- Limpiar anterior si existe
    if highlights[targetPlayer] then
        highlights[targetPlayer]:Destroy()
        highlights[targetPlayer] = nil
    end
    if nameTags[targetPlayer] then
        nameTags[targetPlayer]:Destroy()
        nameTags[targetPlayer] = nil
    end
    
    -- Highlight (caja brillante)
    local hl = Instance.new("Highlight")
    hl.Name = "MM2_ESP_Highlight"
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char
    hl.Parent = char
    highlights[targetPlayer] = hl
    
    -- Nametag con rol
    if SHOW_NAMES then
        local head = char:FindFirstChild("Head")
        if head then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "MM2_ESP_Nametag"
            billboard.Size = UDim2.new(0, 200, 0, 40)
            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
            billboard.AlwaysOnTop = true
            billboard.Parent = head
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.TextStrokeTransparency = 0
            label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            label.Font = Enum.Font.GothamBold
            label.TextSize = 14
            label.Text = ""
            label.Parent = billboard
            
            nameTags[targetPlayer] = billboard
        end
    end
end

-- Actualiza color y texto según rol
local function updateESP(targetPlayer)
    if targetPlayer == player then return end
    local char = targetPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    -- Si no tiene ESP creado, lo creamos
    if not highlights[targetPlayer] then
        createESP(targetPlayer)
    end
    
    local role = getRole(targetPlayer)
    local color = ROLE_COLORS[role]
    
    -- Actualizar color del highlight
    if highlights[targetPlayer] then
        highlights[targetPlayer].FillColor = color
        highlights[targetPlayer].OutlineColor = color
    end
    
    -- Actualizar texto
    if SHOW_NAMES and nameTags[targetPlayer] then
        local label = nameTags[targetPlayer]:FindFirstChildOfClass("TextLabel")
        if label then
            local emoji = ""
            if role == "Murderer" then emoji = "🔪"
            elseif role == "Sheriff" then emoji = "🔫"
            elseif role == "Innocent" then emoji = "😇"
            else emoji = "❓" end
            
            label.Text = string.format("%s %s [%s]", emoji, targetPlayer.Name, role)
            label.TextColor3 = color
        end
    end
end

-- Limpia ESP de un jugador
local function removeESP(targetPlayer)
    if highlights[targetPlayer] then
        highlights[targetPlayer]:Destroy()
        highlights[targetPlayer] = nil
    end
    if nameTags[targetPlayer] then
        nameTags[targetPlayer]:Destroy()
        nameTags[targetPlayer] = nil
    end
end

-- Limpia TODO
local function clearAllESP()
    for p, hl in pairs(highlights) do
        if hl then hl:Destroy() end
    end
    for p, tag in pairs(nameTags) do
        if tag then tag:Destroy() end
    end
    highlights = {}
    nameTags = {}
end

-- Loop principal: actualiza cada X segundos
local function startESPLoop()
    task.spawn(function()
        while espEnabled do
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then
                    updateESP(p)
                end
            end
            task.wait(UPDATE_RATE)
        end
    end)
end

-- Activar / desactivar
local function toggleESP()
    espEnabled = not espEnabled
    if espEnabled then
        btn.TextColor3 = Color3.fromRGB(0, 255, 120)
        stroke.Color = Color3.fromRGB(0, 255, 120)
        btn.Text = "🎯\nON"
        startESPLoop()
    else
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        stroke.Color = Color3.fromRGB(150, 150, 150)
        btn.Text = "🎯\nESP"
        clearAllESP()
    end
end

btn.MouseButton1Click:Connect(toggleESP)

-- Limpiar cuando alguien sale del juego
Players.PlayerRemoving:Connect(function(p)
    removeESP(p)
end)

-- Limpiar cuando un jugador respawnea (por si acaso)
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(1)
        if espEnabled then
            updateESP(p)
        end
    end)
end)

print("✅ MM2 ESP cargado. Toca el botón 🎯 ESP para activar.")
