    PrimaryDark = Color3.fromRGB(140, 15, 25),      -- Rojo oscuro
    Accent      = Color3.fromRGB(255, 80, 80),      -- Rojo claro (para brillos)
    Background  = Color3.fromRGB(15, 8, 10),        -- Casi negro rojizo
    Panel       = Color3.fromRGB(22, 12, 15),       -- Panel
    Header      = Color3.fromRGB(30, 15, 18),       -- Header
    Item        = Color3.fromRGB(32, 18, 22),       -- Items
    Text        = Color3.fromRGB(245, 235, 235),    -- Texto claro
    TextDim     = Color3.fromRGB(170, 140, 140),    -- Texto apagado
    Off         = Color3.fromRGB(60, 40, 45),       -- Switch apagado
}

local Config = {
    ESP = false,
    ESPDistancia = false,
    ESPArmas = false,
    ESPCaja2D = false,
    Speed = false,
    Jump = false,
