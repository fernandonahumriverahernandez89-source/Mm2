local s1 = Instance.new("UIStroke")
s1.Color = Theme.Primary
s1.Thickness = 2
s1.Parent = OpenBtn

-- Animación de pulso del botón
task.spawn(function()
    while OpenBtn.Parent do
        local tween = TweenService:Create(s1, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
            Transparency = 0.7
        })
        tween:Play()
        task.wait(1.5)
        local tween2 = TweenService:Create(s1, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
            Transparency = 0
        })
        tween2:Play()
        task.wait(1.5)
    end
end)

