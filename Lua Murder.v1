    Murderer = Color3.fromRGB(255, 40, 40),
    Sheriff  = Color3.fromRGB(40, 130, 255),
    Innocent = Color3.fromRGB(40, 220, 90),
    Unknown  = Color3.fromRGB(180, 180, 180),
}

