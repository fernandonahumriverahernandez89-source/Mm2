-- ========================================
--           CREAR ITEM (toggle)
-- ========================================
local function crearItem(nombre, emoji, callback)
    local item = Instance.new("TextButton")
    item.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    item.Text = ""
    item.BorderSizePixel = 0
    item.AutoButtonColor = false
    item.Parent = ItemsHolder
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = item
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 75)
    stroke.Thickness = 1.5
    stroke.Parent = item
    
    local emojiLbl = Instance.new("TextLabel")
    emojiLbl.Size = UDim2.new(0, 22, 0, 20)
    emojiLbl.Position = UDim2.new(0, 8, 0, 4)
    emojiLbl.BackgroundTransparency = 1
    emojiLbl.Text = emoji
    emojiLbl.TextSize = 15
    emojiLbl.Font = Enum.Font.GothamBold
    emojiLbl.TextXAlignment = Enum.TextXAlignment.Left
    emojiLbl.Parent = item
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -14, 0, 14)
    lbl.Position = UDim2.new(0, 8, 1, -17)
    lbl.BackgroundTransparency = 1
    lbl.Text = nombre
    lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = item
    
    local switch = Instance.new("Frame")
    switch.Size = UDim2.new(0, 30, 0, 15)
    switch.Position = UDim2.new(1, -38, 0, 6)
    switch.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    switch.BorderSizePixel = 0
    switch.Parent = item
    
    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switch
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 11, 0, 11)
    knob.Position = UDim2.new(0, 2, 0.5, -5.5)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = switch
    
    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob
    
    local isOn = false
    
    local function setState(state)
        isOn = state
        if isOn then
            switch.BackgroundColor3 = Color3.fromRGB(0, 220, 255)
            knob.Position = UDim2.new(1, -13, 0.5, -5.5)
            stroke.Color = Color3.fromRGB(0, 220, 255)
            lbl.TextColor3 = Color3.fromRGB(0, 220, 255)
        else
            switch.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
            knob.Position = UDim2.new(0, 2, 0.5, -5.5)
            stroke.Color = Color3.fromRGB(60, 60, 75)
            lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
        end
        if callback then callback(isOn) end
    end
    
    item.MouseButton1Click:Connect(function()
        setState(not isOn)
    end)
    
    return setState
end

